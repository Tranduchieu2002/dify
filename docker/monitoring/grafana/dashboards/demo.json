          "editorMode": "code",
          "expr": "sum(rate(dify_workflow_runs_total{app_name=~\"$app\", status=~\"succeeded|partial-succeeded\"}[5m])) / clamp_min(sum(rate(dify_workflow_runs_total{app_name=~\"$app\"}[5m])), 1e-9)",
          "legendFormat": "ok",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
