          "editorMode": "code",
          "expr": "topk(20, sum by (node_type, node_title, error_class) (increase(dify_workflow_node_errors_total{app_name=~\"$app\"}[1h])))",
          "legendFormat": "",
          "range": false,
          "instant": true,
