      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "id": 9,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Failed Count" }]
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "dify-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  wne.node_type AS \"Node Type\",\n  COUNT(*) AS \"Failed Count\",\n  COUNT(DISTINCT wne.workflow_run_id) AS \"Affected Runs\",\n  ROUND(AVG(wne.elapsed_time), 2) AS \"Avg Duration (s)\"\nFROM workflow_node_executions wne\nWHERE wne.status = 'failed'\n  AND $__timeFilter(wne.created_at)\nGROUP BY wne.node_type\nORDER BY \"Failed Count\" DESC",
          "refId": "A"
        }
      ],
      "title": "Failing Node Types",
      "type": "table"
    }
  ],
  "refresh": "1m",
