          }
        ]
      },
      "gridPos": { "h": 9, "w": 14, "x": 0, "y": 13 },
      "id": 6,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Failed" }]
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "dify-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COALESCE(a.name, 'Unknown') AS \"App\",\n  COUNT(*) AS \"Total\",\n  SUM(CASE WHEN wr.status = 'failed' THEN 1 ELSE 0 END) AS \"Failed\",\n  ROUND(\n    100.0 * SUM(CASE WHEN wr.status = 'failed' THEN 1 ELSE 0 END)\n      / NULLIF(COUNT(*), 0),\n    1\n  ) AS \"Failure Rate %\"\nFROM workflow_runs wr\nLEFT JOIN apps a ON a.id = wr.app_id\nWHERE $__timeFilter(wr.created_at)\nGROUP BY a.name, wr.app_id\nHAVING SUM(CASE WHEN wr.status = 'failed' THEN 1 ELSE 0 END) > 0\nORDER BY \"Failed\" DESC\nLIMIT 10",
          "refId": "A"
        }
      ],
      "title": "Top Apps by Failure Count",
      "type": "table"
    },
    {
      "datasource": { "type": "postgres", "uid": "dify-postgres" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "filterable": true,
            "inspect": false
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Count" },
            "properties": [
              { "id": "custom.width", "value": 70 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "yellow", "value": null },
                    { "color": "red", "value": 10 }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "App" },
            "properties": [{ "id": "custom.width", "value": 120 }]
          }
        ]
      },
      "gridPos": { "h": 9, "w": 10, "x": 14, "y": 13 },
      "id": 7,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Count" }]
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "dify-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COUNT(*) AS \"Count\",\n  COALESCE(a.name, 'Unknown') AS \"App\",\n  LEFT(COALESCE(wr.error, ''), 150) AS \"Error\"\nFROM workflow_runs wr\nLEFT JOIN apps a ON a.id = wr.app_id\nWHERE wr.status = 'failed'\n  AND wr.error IS NOT NULL\n  AND wr.error != ''\n  AND $__timeFilter(wr.created_at)\nGROUP BY a.name, LEFT(COALESCE(wr.error, ''), 150)\nORDER BY \"Count\" DESC\nLIMIT 15",
          "refId": "A"
        }
      ],
      "title": "Top Error Messages",
      "type": "table"
    },
