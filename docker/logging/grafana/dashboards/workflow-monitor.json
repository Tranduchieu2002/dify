      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "dify-postgres" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  date_trunc('hour', created_at) AS \"time\",\n  SUM(CASE WHEN status = 'succeeded' THEN 1 ELSE 0 END)         AS \"Succeeded\",\n  SUM(CASE WHEN status = 'failed' THEN 1 ELSE 0 END)            AS \"Failed\",\n  SUM(CASE WHEN status = 'stopped' THEN 1 ELSE 0 END)           AS \"Stopped\",\n  SUM(CASE WHEN status = 'partial-succeeded' THEN 1 ELSE 0 END) AS \"Partial\"\nFROM workflow_runs\nWHERE $__timeFilter(created_at)\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
      ],
      "title": "Workflow Runs — Timeline by Status (hourly)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "postgres", "uid": "dify-postgres" },
      "fieldConfig": {
