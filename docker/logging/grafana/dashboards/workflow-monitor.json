      "id": 8,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Time" }]
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "dify-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  wr.created_at AS \"Time\",\n  COALESCE(a.name, 'Unknown') AS \"App\",\n  wr.status AS \"Status\",\n  wr.triggered_from AS \"Trigger\",\n  ROUND(wr.elapsed_time::numeric, 2) AS \"Duration (s)\",\n  wr.total_tokens AS \"Tokens\",\n  LEFT(COALESCE(wr.error, ''), 200) AS \"Error\"\nFROM workflow_runs wr\nLEFT JOIN apps a ON a.id = wr.app_id\nWHERE wr.status IN ('failed', 'partial-succeeded')\n  AND $__timeFilter(wr.created_at)\nORDER BY wr.created_at DESC\nLIMIT 50",
          "refId": "A"
        }
      ],
      "title": "Recent Failed Runs (last 50)",
      "type": "table"
    },
